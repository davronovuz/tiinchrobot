# Bot sozlamalari
ADMINS=12345678,12345677,12345676
BOT_TOKEN=123452345243:Asdfasdfasf

# PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_NAME=tiinchrobot
DB_USER=botuser
DB_PASS=botpassword

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Pyrogram (my.telegram.org dan oling)
API_ID=12345678
API_HASH=abcdef1234567890abcdef1234567890

# Local Bot API server (2GB fayl limiti). O'chirish uchun bo'sh qoldiring.
# MUHIM: birinchi marta ishlatishdan oldin cloud API dan chiqish kerak:
#   curl "https://api.telegram.org/bot<TOKEN>/logOut"
BOT_API_URL=http://telegram-bot-api:8081

# Umumiy
ip=localhost

# Docker image (GHCR). Lokal build uchun bo'sh qoldiring.
BOT_IMAGE=ghcr.io/davronovuz/tiinchrobot:latest
